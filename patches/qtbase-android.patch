 {
+    // openscad-android: not while Android has destroyed the window's Surface (the Surface is created on the first
+    // render, so a window that never had one counts as exposed). Without a Surface every flush of the window tried to
+    // create a GL context and failed ("no EGLSurface", "Failed to create QRhi"), over and over, until Android gave it
+    // a new Surface; the emulator's GPU emulation leaked memory doing so.
+    const bool surfaceGone = m_surfaceCreated && !m_hasAndroidSurface.load();
     return qApp->applicationState() > Qt::ApplicationHidden
             && window()->isVisible()
-            && !window()->geometry().isEmpty();
+            && !window()->geometry().isEmpty()
+            && (isEmbeddingContainer() || !surfaceGone || ignoreSurfaceForExpose());
 }
 
