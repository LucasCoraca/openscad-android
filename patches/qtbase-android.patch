+namespace {
+// openscad-android: QRhiBackingStore uploads only the region of each flush to the window's texture, so the content of
+// a flush that doesn't make it to the screen (window not exposed yet, swap chain out of date, a dropped frame) is lost
+// for good, and stale pixels stay until that area is painted again (seen in dialogs, menus, stacked pages). Upload the
+// whole window every time: a flush happens only when something changed, and the whole texture is drawn anyway.
+class QAndroidWholeWindowBackingStore : public QRhiBackingStore
+{
+public:
+    using QRhiBackingStore::QRhiBackingStore;
+    FlushResult rhiFlush(QWindow *window, qreal sourceDevicePixelRatio, const QRegion &region, const QPoint &offset,
+                         QPlatformTextureList *textures, bool translucentBackground) override
+    {
+        static const bool partial = qEnvironmentVariableIsSet("QT_ANDROID_PARTIAL_FLUSH");  // diagnostics
+        return QRhiBackingStore::rhiFlush(window, sourceDevicePixelRatio,
+                                          partial ? region : QRegion(QRect(QPoint(), window->size())),
+                                          offset, textures, translucentBackground);
+    }
+};
+} // namespace
+
 QPlatformBackingStore *QAndroidPlatformIntegration::createPlatformBackingStore(QWindow *window) const
 {
     if (!QtAndroidPrivate::activity().isValid())
         return nullptr;
 
-    return new QRhiBackingStore(window);
+    return new QAndroidWholeWindowBackingStore(window);
 }
 
 QPlatformOpenGLContext *QAndroidPlatformIntegration::createPlatformOpenGLContext(QOpenGLContext *context) const
