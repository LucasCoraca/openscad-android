+  touch_long_press->stop();
+  touch_fingers = 0;
+  if (!touch_moved) mouse_drag_moved = false;  // a tap is a click, however the finger wobbled
+  touchMouse(QEvent::MouseButtonRelease, pos, Qt::LeftButton, Qt::NoButton);
+  if (!touch_moved) {
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    if (now - touch_last_tap_ms < QGuiApplication::styleHints()->mouseDoubleClickInterval() &&
+        QLineF(pos, touch_last_tap).length() < 3 * tapSlop) {
+      touchMouse(QEvent::MouseButtonDblClick, pos, Qt::LeftButton, Qt::LeftButton);
+      touch_last_tap_ms = 0;
+    } else {
+      touch_last_tap_ms = now;
+      touch_last_tap = pos;
+    }
+  }
+  return true;
+}
