diff --git a/src/glview/gl-android-prefix.h b/src/glview/gl-android-prefix.h
new file mode 100644
index 0000000..f61e3d7
--- /dev/null
+++ b/src/glview/gl-android-prefix.h
@@ -0,0 +1,14 @@
+#pragma once
+
+// Android: included before every C++ source of OpenSCADLibInternal. OpenSCAD draws with desktop GL (GLAD, functions
+// from gl4es), while Qt's headers (QOpenGLWidget -> qopengl.h) bring in OpenGL ES ones. GLAD goes first, so its types
+// serve both and the GLES headers are skipped (GLAD defines __gl2_h_); Qt's GLES extension header is skipped too.
+// (No EGL headers after this: their prototypes clash with GLAD's too.)
+#include "glad/gl.h"
+#ifndef __gles2_gl2ext_h_
+#define __gles2_gl2ext_h_ 1
+#endif
+#include <QtGui/qopengl.h>
+// QOpenGLFunctions' GLES inline wrappers call ::gl* directly, which GLAD has made into macros; OpenSCAD doesn't use them
+#define QOPENGLFUNCTIONS_H
+#define QOPENGLEXTRAFUNCTIONS_H
diff --git a/src/glview/gl4es-android.cc b/src/glview/gl4es-android.cc
new file mode 100644
index 0000000..cb60619
--- /dev/null
+++ b/src/glview/gl4es-android.cc
@@ -0,0 +1,55 @@
+#include "glview/gl4es-android.h"
+
+#include <dlfcn.h>
+#include <android/log.h>
+
+#include <gl4es/gl4esinit.h>
+
+namespace gl4es_android {
+
+namespace {
+
+bool initialized = false;
+int fbWidth = 0;
+int fbHeight = 0;
+
+// gl4es asks for the real GLES functions here (it is built with NOEGL: no context handling of its own)
+void *glesProc(const char *name)
+{
+  static void *gles = dlopen("libGLESv2.so", RTLD_NOW | RTLD_LOCAL);
+  // (EGL's header can't be included next to GLAD's, see gl-android-prefix.h)
+  using GetProc = void *(*)(const char *);
+  static auto eglGetProc = reinterpret_cast<GetProc>(dlsym(dlopen("libEGL.so", RTLD_NOW | RTLD_LOCAL), "eglGetProcAddress"));
+  void *p = gles ? dlsym(gles, name) : nullptr;
+  if (!p && eglGetProc) p = eglGetProc(name);
+  return p;
+}
+
+void mainFramebufferSize(int *width, int *height)
+{
+  *width = fbWidth;
+  *height = fbHeight;
+}
+
+}  // namespace
+
+void beginFrame(unsigned int fbo, int width, int height)
+{
+  fbWidth = width;
+  fbHeight = height;
+  if (!initialized) {
+    set_getprocaddress(glesProc);
+    set_getmainfbsize(mainFramebufferSize);
+    initialize_gl4es();
+    initialized = true;
+    __android_log_print(ANDROID_LOG_INFO, "openscad", "gl4es initialized on the view's GLES context");
+  }
+  gl4es_setDefaultFramebuffer(fbo, width, height);
+}
+
+Proc getProcAddress(const char *name)
+{
+  return reinterpret_cast<Proc>(gl4es_GetProcAddress(name));
+}
+
+}  // namespace gl4es_android
diff --git a/src/glview/gl4es-android.h b/src/glview/gl4es-android.h
new file mode 100644
index 0000000..ec6848e
--- /dev/null
+++ b/src/glview/gl4es-android.h
@@ -0,0 +1,15 @@
+#pragma once
+
+// Android: OpenSCAD's renderers use legacy desktop OpenGL (fixed function, GLSL 1.20). gl4es emulates it on the
+// OpenGL ES context Qt created for the view; GLAD loads its functions from here.
+namespace gl4es_android {
+
+// Call with the GLES context current, before drawing: initializes gl4es on first use, and makes `fbo` (the FBO the
+// widget draws into) what framebuffer 0 means.
+void beginFrame(unsigned int fbo, int width, int height);
+
+// The desktop GL entry point `name`, as GLAD's loader expects it.
+using Proc = void (*)(void);
+Proc getProcAddress(const char *name);
+
+}  // namespace gl4es_android
