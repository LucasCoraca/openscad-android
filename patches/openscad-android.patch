+
+QString pathForWrite(const QString& picked)
+{
+  if (!isDocument(picked)) return picked;
+  keepPermission(picked);
+  const QString local = localCopyPath(picked);
+  remember(local, picked);
+  return local;
+}
+
+QString pathForRead(const QString& picked)
+{
+  if (!isDocument(picked)) return picked;
+  keepPermission(picked);
+  const QString local = localCopyPath(picked);
+  if (!copyFile(picked, local)) {
+    LOG(message_group::Error, "Cannot read \"%1$s\"", picked.toStdString());
+    return {};
+  }
+  remember(local, picked);
+  return local;
+}
+
+bool commit(const QString& path)
+{
+  const QString uri = documentFor(path);
+  if (uri.isEmpty()) return true;  // an ordinary file
+  if (copyFile(path, uri)) return true;
+  LOG(message_group::Error, "Cannot write \"%1$s\" to \"%2$s\"", path.toStdString(), uri.toStdString());
+  return false;
+}
+
+QString displayName(const QString& path)
+{
+  const QString uri = documentFor(path);
+  return uri.isEmpty() ? path : QFileInfo(path).fileName();
+}
