diff --git a/src/gui/AndroidDocuments.cc b/src/gui/AndroidDocuments.cc
new file mode 100644
index 0000000..ceafd30
--- /dev/null
+++ b/src/gui/AndroidDocuments.cc
@@ -0,0 +1,132 @@
+#include "gui/AndroidDocuments.h"
+
+#include <QString>
+
+#ifndef Q_OS_ANDROID
+
+namespace AndroidDocuments {
+QString pathForWrite(const QString& picked) { return picked; }
+QString pathForRead(const QString& picked) { return picked; }
+bool commit(const QString&) { return true; }
+QString displayName(const QString& path) { return path; }
+}  // namespace AndroidDocuments
+
+#else
+
+#include <QCoreApplication>
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJniEnvironment>
+#include <QJniObject>
+#include <QSettings>
+#include <QStandardPaths>
+
+#include "utils/printutils.h"
+
+namespace AndroidDocuments {
+
+namespace {
+
+constexpr auto kSettingsGroup = "android/documents";  // local copy path -> content:// URI
+
+bool isDocument(const QString& path) { return path.startsWith(QLatin1String("content:")); }
+
+// keep access to the document across restarts (the picker grants it for this session only)
+void keepPermission(const QString& uri)
+{
+  const QJniObject context = QNativeInterface::QAndroidApplication::context();
+  const QJniObject resolver =
+    context.callObjectMethod("getContentResolver", "()Landroid/content/ContentResolver;");
+  const QJniObject jUri = QJniObject::callStaticObjectMethod(
+    "android/net/Uri", "parse", "(Ljava/lang/String;)Landroid/net/Uri;", QJniObject::fromString(uri).object());
+  if (!resolver.isValid() || !jUri.isValid()) return;
+  constexpr jint readWrite = 1 | 2;  // Intent.FLAG_GRANT_READ_URI_PERMISSION | FLAG_GRANT_WRITE_URI_PERMISSION
+  resolver.callMethod<void>("takePersistableUriPermission", "(Landroid/net/Uri;I)V", jUri.object(), readWrite);
+  QJniEnvironment env;
+  if (env.checkAndClearExceptions()) {  // not persistable (some providers): fine for this session
+    resolver.callMethod<void>("takePersistableUriPermission", "(Landroid/net/Uri;I)V", jUri.object(), jint(1));
+    env.checkAndClearExceptions();
+  }
+}
+
+// a stable local path for the document: <cache>/documents/<hash of the URI>/<its display name>
+QString localCopyPath(const QString& uri)
+{
+  QString name = QFileInfo(uri).fileName();  // Qt's content file engine asks the provider for the display name
+  if (name.isEmpty() || name.contains('/')) name = QStringLiteral("document");
+  const QString hash =
+    QString::fromLatin1(QCryptographicHash::hash(uri.toUtf8(), QCryptographicHash::Sha1).toHex().left(12));
+  const QString dir =
+    QStandardPaths::writableLocation(QStandardPaths::CacheLocation) + QStringLiteral("/documents/") + hash;
+  QDir().mkpath(dir);
+  return dir + '/' + name;
+}
+
+void remember(const QString& local, const QString& uri)
+{
+  QSettings settings;
+  settings.beginGroup(kSettingsGroup);
+  settings.setValue(QString::fromLatin1(local.toUtf8().toBase64()), uri);
+}
+
+QString documentFor(const QString& local)
+{
+  QSettings settings;
+  settings.beginGroup(kSettingsGroup);
+  return settings.value(QString::fromLatin1(local.toUtf8().toBase64())).toString();
+}
+
+bool copyFile(const QString& from, const QString& to)
+{
+  QFile in(from);
+  if (!in.open(QIODevice::ReadOnly)) return false;
+  QFile out(to);
+  if (!out.open(QIODevice::WriteOnly | QIODevice::Truncate)) return false;
+  const QByteArray data = in.readAll();
+  return out.write(data) == data.size();
+}
