+      const QPointF center = (down[0] + down[1]) / 2;
+      const double distance = QLineF(down[0], down[1]).length();
+      touchMouse(QEvent::MouseMove, center, Qt::NoButton, Qt::RightButton);  // pan
+      if (touch_distance > 0 && distance > 0) {
+        // fingers apart -> closer: Camera::zoom() scales the distance by 0.9^(steps/120)
+        touch_zoom_rest += 120.0 * std::log(touch_distance / distance) / std::log(0.9);
+        const int steps = static_cast<int>(touch_zoom_rest);
+        if (steps != 0) {
+          touch_zoom_rest -= steps;
+          zoomCursor(static_cast<int>(center.x()), static_cast<int>(center.y()), steps);
+        }
+      }
+      touch_center = center;
+      touch_distance = distance;
