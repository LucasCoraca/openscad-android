@@ -0,0 +1,9 @@
+#version 120
+
+// Depth of the fragment packed into 24 bits of RGB, for platforms that can't read the depth buffer (OpenGL ES).
+uniform vec3 frag_idcolor;  // unused; set by renderers drawing for selection
+void main() {
+  vec3 enc = fract(gl_FragCoord.z * vec3(1.0, 255.0, 65025.0));
+  enc -= enc.yzz * vec3(1.0 / 255.0, 1.0 / 255.0, 0.0);
+  gl_FragColor = vec4(enc, 1.0);
+}
