+#ifdef Q_OS_ANDROID
+void QGLView::touchMouse(QEvent::Type type, const QPointF& pos, Qt::MouseButton button, Qt::MouseButtons buttons)
+{
+  QMouseEvent me(type, pos, mapToGlobal(pos), button, buttons, Qt::NoModifier);
+  switch (type) {
+  case QEvent::MouseButtonPress:         mousePressEvent(&me); break;
+  case QEvent::MouseMove:                mouseMoveEvent(&me); break;
+  case QEvent::MouseButtonRelease:       mouseReleaseEvent(&me); break;
+  case QEvent::MouseButtonDblClick:      mouseDoubleClickEvent(&me); break;
+  default: break;
+  }
+}
+
+bool QGLView::event(QEvent *event)
+{
+  const auto type = event->type();
+  if (type != QEvent::TouchBegin && type != QEvent::TouchUpdate && type != QEvent::TouchEnd &&
+      type != QEvent::TouchCancel) {
+    return QOpenGLWidget::event(event);
+  }
+  auto *te = static_cast<QTouchEvent *>(event);
+  event->accept();
+  QList<QPointF> down;  // positions of the fingers still on the screen
+  for (const auto& p : te->points()) {
+    if (p.state() != QEventPoint::Released) down.append(p.position());
+  }
+  const double tapSlop = 10.0 * devicePixelRatio();
+
+  if (type == QEvent::TouchBegin) {
+    touch_fingers = 1;
+    touch_moved = false;
+    touch_long_pressed = false;
+    touch_start = down.value(0);
+    touch_long_press->start();
+    touchMouse(QEvent::MouseButtonPress, touch_start, Qt::LeftButton, Qt::LeftButton);
+    return true;
+  }
+
+  if (type == QEvent::TouchCancel) {
+    touch_long_press->stop();
+    if (touch_fingers == 1 && !touch_long_pressed) {
+      mouse_drag_moved = true;  // no click
+      touchMouse(QEvent::MouseButtonRelease, touch_start, Qt::LeftButton, Qt::NoButton);
+    } else if (touch_fingers >= 2) {
+      touchMouse(QEvent::MouseButtonRelease, touch_center, Qt::RightButton, Qt::NoButton);
+    }
+    touch_fingers = 0;
+    return true;
+  }
+
+  if (down.size() >= 2 && touch_fingers < 2) {
+    // a second finger: end the one finger drag without a click, start pinch/pan
+    touch_long_press->stop();
+    if (!touch_long_pressed) {
+      mouse_drag_moved = true;
+      touchMouse(QEvent::MouseButtonRelease, touch_start, Qt::LeftButton, Qt::NoButton);
+    }
+    touch_fingers = 2;
+    touch_center = (down[0] + down[1]) / 2;
+    touch_distance = QLineF(down[0], down[1]).length();
+    touch_zoom_rest = 0;
