diff -ruN gl4es-orig/include/gl4esinit.h gl4es-1.1.6/include/gl4esinit.h
--- gl4es-orig/include/gl4esinit.h	2024-05-04 12:35:02.000000000 -0300
+++ gl4es-1.1.6/include/gl4esinit.h	2026-10-25 01:30:27.656139549 -0300
@@ -22,6 +22,8 @@
 void initialize_gl4es(void);
 // do this to uninitialize GL4ES if init constructors are disabled.
 void close_gl4es(void);
+// make `fbo` what framebuffer 0 means (embedding in a toolkit that renders into its own FBO); call each frame
+void gl4es_setDefaultFramebuffer(unsigned int fbo, int width, int height);
 // wrapped GetProcAddress
 void* APIENTRY_GL4ES gl4es_GetProcAddress(const char *name);
 
diff -ruN gl4es-orig/src/gl/framebuffers.c gl4es-1.1.6/src/gl/framebuffers.c
--- gl4es-orig/src/gl/framebuffers.c	2024-05-04 12:35:02.000000000 -0300
+++ gl4es-1.1.6/src/gl/framebuffers.c	2026-10-25 01:30:27.675724039 -0300
@@ -1814,3 +1814,84 @@
 AliasExport(void,glClearNamedFramebufferuiv,EXT,(GLuint framebuffer, GLenum buffer, GLint drawbuffer, const GLuint *value));
 AliasExport(void,glClearNamedFramebufferfv,EXT,(GLuint framebuffer, GLenum buffer, GLint drawbuffer, const GLfloat *value));
 AliasExport(void,glClearNamedFramebufferfi,EXT,(GLuint framebuffer, GLenum buffer, GLint drawbuffer, GLfloat depth, GLint stencil));
+
+// Embedding in a toolkit that renders into its own FBO (Qt's QOpenGLWidget on Android): make `fbo` the framebuffer
+// that "framebuffer 0" means, and mark it bound, at the start of every frame the toolkit hands over.
+EXPORT
+void gl4es_setDefaultFramebuffer(GLuint fbo, int width, int height) {
+    if(!glstate) return;
+    glstate->fbo.mainfbo_fbo = fbo;
+    glstate->fbo.mainfbo_width = width;
+    glstate->fbo.mainfbo_height = height;
+    glstate->fbo.fbo_read = glstate->fbo.fbo_draw = glstate->fbo.current_fb = glstate->fbo.fbo_0;
+    glstate->fbo.internal = 0;
+    // The toolkit binds textures (its FBO's, when it recreates it) behind our back: forget which textures we think
+    // are bound and which unit is active, so the next use binds for real instead of being skipped as redundant.
+    for (int i = 0; i < MAX_TEX; i++)
+        glstate->actual_tex2d[i] = 0xffffffffu;
+    glstate->gleshard->active = 0xffffffffu;
+
+    // The toolkit also draws on this context between frames (its compositor) and sets up some state before handing
+    // it over, all behind gl4es's back. gl4es skips calls that would not change the state it believes is current, so
+    // a draw would run with the toolkit's program, scissor box or blend state (objects vanished from the view).
+    // What the toolkit sets right before the frame (no program, no array buffer, the viewport) gl4es now believes;
+    // everything else that gl4es shadows is sent to the context again.
+    glstate->gleshard->program = 0;
+    glstate->gleshard->glprogram = NULL;
+    glstate->bind_buffer.array = 0;
+    glstate->raster.viewport.x = glstate->raster.viewport.y = 0;
+    glstate->raster.viewport.width = width;
+    glstate->raster.viewport.height = height;
+
+    LOAD_GLES(glEnable);
+    LOAD_GLES(glDisable);
+    LOAD_GLES(glBindBuffer);
+    LOAD_GLES(glDepthFunc);
+    LOAD_GLES(glDepthMask);
+    LOAD_GLES(glColorMask);
+    LOAD_GLES(glCullFace);
+    LOAD_GLES(glFrontFace);
+    LOAD_GLES(glScissor);
+    LOAD_GLES2(glDisableVertexAttribArray);
+    LOAD_GLES2_OR_OES(glBlendFuncSeparate);
+    LOAD_GLES2_OR_OES(glBlendEquationSeparate);
+    LOAD_GLES2(glStencilFuncSeparate);
+    LOAD_GLES2(glStencilOpSeparate);
+    LOAD_GLES2(glStencilMaskSeparate);
+    #define SYNC_ENABLE(cap, on) ((on) ? gles_glEnable(cap) : gles_glDisable(cap))
+    SYNC_ENABLE(GL_DEPTH_TEST, glstate->enable.depth_test);
+    SYNC_ENABLE(GL_CULL_FACE, glstate->enable.cull_face);
+    SYNC_ENABLE(GL_STENCIL_TEST, glstate->enable.stencil_test);
+    gles_glDisable(GL_SCISSOR_TEST);    // not shadowed: what OpenSCAD expects at the start of a frame
+    if (!(glstate->fpe_state && globals4es.shaderblend)) {
+        SYNC_ENABLE(GL_BLEND, glstate->enable.blend);
+        if (gles_glBlendFuncSeparate)
+            gles_glBlendFuncSeparate(glstate->blendsfactorrgb, glstate->blenddfactorrgb,
+                                     glstate->blendsfactoralpha, glstate->blenddfactoralpha);
+        if (gles_glBlendEquationSeparate)
+            gles_glBlendEquationSeparate(glstate->blendeqrgb ? glstate->blendeqrgb : GL_FUNC_ADD,
+                                         glstate->blendeqalpha ? glstate->blendeqalpha : GL_FUNC_ADD);
+    }
+    #undef SYNC_ENABLE
+    gles_glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, glstate->bind_buffer.index);
+    gles_glDepthFunc(glstate->depth.func);
+    gles_glDepthMask(glstate->depth.mask);
+    gles_glColorMask(glstate->colormask[0], glstate->colormask[1], glstate->colormask[2], glstate->colormask[3]);
+    gles_glCullFace(glstate->face.cull);
+    gles_glFrontFace(glstate->face.front);
+    gles_glScissor(glstate->raster.scissor.x, glstate->raster.scissor.y,
+                   glstate->raster.scissor.width, glstate->raster.scissor.height);
+    for (int f = 0; f < 2; f++) {
+        const GLenum face = f ? GL_BACK : GL_FRONT;
+        gles_glStencilFuncSeparate(face, glstate->stencil.func[f], glstate->stencil.f_ref[f], glstate->stencil.f_mask[f]);
+        gles_glStencilOpSeparate(face, glstate->stencil.sfail[f], glstate->stencil.dpfail[f], glstate->stencil.dppass[f]);
+        gles_glStencilMaskSeparate(face, glstate->stencil.mask[f]);
+    }
+    // vertex arrays: disable them all, and make gl4es specify every array it uses again
+    for (int i = 0; i < hardext.maxvattrib; i++) {
+        gles_glDisableVertexAttribArray(i);
+        glstate->gleshard->vertexattrib[i].enabled = 0;
+        glstate->gleshard->vertexattrib[i].size = -1;
+        memset(glstate->gleshard->vavalue[i], 0xff, sizeof(glstate->gleshard->vavalue[i]));
+    }
+}
